# ==============================
# App
# ==============================
APP_NAME=SentinelGuard AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ==============================
# Security / JWT
# ==============================
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================
# Database (PostgreSQL)
# ==============================
POSTGRES_USER=sentinelguard
POSTGRES_PASSWORD=sentinelguard_pw
POSTGRES_DB=sentinelguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinelguard:sentinelguard_pw@postgres:5432/sentinelguard

# ==============================
# Redis
# ==============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==============================
# Vector Store (FAISS)
# ==============================
FAISS_INDEX_DIR=/app/data/faiss_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==============================
# LLM Providers (optional - fallback to offline mode if absent)
# ==============================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic

# ==============================
# Uploads
# ==============================
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=25

# ==============================
# CORS
# ==============================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
